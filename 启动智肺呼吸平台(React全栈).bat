@echo off
chcp 65001 >nul
title 智肺呼吸 (RespiCare 360) - React + Flask 全栈服务启动器
cd /d "%~dp0"

echo ==============================================================================
echo [1/3] 正在启动 Flask 后端 API 服务 (端口 5001)...
echo ==============================================================================
start "智肺呼吸-Flask后端[5001]" cmd /k "cd /d "%~dp0backend" && python app.py"

echo.
echo ==============================================================================
echo [2/3] 正在启动 React 18 + Vite 前端开发服务器 (端口 5173)...
echo ==============================================================================
start "智肺呼吸-React前端[5173]" cmd /k "cd /d "%~dp0frontend" && npm run dev"

echo.
echo ==============================================================================
echo [3/3] 正在调起默认浏览器访问平台...
echo ==============================================================================
timeout /t 3 >nul
start http://localhost:5173/

echo.
echo ==============================================================================
echo 恭喜！智肺呼吸 (RespiCare 360) React 全栈平台已成功启动！
echo.
echo 前端 React (Vite) 访问地址: http://localhost:5173/
