@echo off
chcp 65001 >nul
title 智肺呼吸 (RespiCare 360) - 全栈服务一键启动器
cd /d "%~dp0"

echo ==============================================================================
echo [1/3] 正在启动 Flask 后端 API 服务 (端口 5001)...
echo ==============================================================================
start "智肺呼吸-Flask后端[5001]" cmd /k "cd /d "%~dp0backend" && python app.py"

echo.
echo ==============================================================================
echo [2/3] 正在启动 Web 自适应前端 HTTP 服务器 (端口 8080)...
echo ==============================================================================
start "智肺呼吸-Web静态服务[8080]" cmd /k "cd /d "%~dp0web" && python -m http.server 8080"

echo.
echo ==============================================================================
echo [3/3] 正在调起默认浏览器访问平台...
echo ==============================================================================
timeout /t 2 >nul
start http://localhost:8080/index.html

echo.
echo ==============================================================================
echo 恭喜！智肺呼吸 (RespiCare 360) 慢阻肺全周期平台已成功启动！
echo.
echo 电脑宽屏 / 手机端自适应访问地址: http://localhost:8080/index.html
echo 后端 Flask RESTful API 接口地址: http://localhost:5001/api/health
echo 数据库连接: MySQL 8.0 (3306, respicare_db) + Neo4j 5.x (7687)
echo.
echo 预置五大角色测试账号 (初始密码均为 123456):
echo 1. 患者端: 13800000001 (张建国, GOLD E组)
echo 2. 医生端: DOC8801 或 13900000002 (李华山, 呼吸主任医师)
echo 3. 护士端: NUR6601 或 13700000003 (王春燕, 专科护士长)
echo 4. 院长端: DIR0001 或 13600000004 (陈远东, 业务副院长)
echo 5. 运维端: ADM9901 或 13500000005 (周天成, 系统架构师)
echo ==============================================================================
pause
